# ==========================================
# Taiwan Stock Research Agent - Configuration
# ==========================================

# 1. LiteLLM / API Gateway Configuration (Required)
# Points to your K8s internal LiteLLM ingress or gateway service URL
LLM_API_BASE=http://litellm-service.namespace.svc.cluster.local/v1
LLM_API_KEY=your_litellm_api_key_here
LLM_MODEL=gemini-1.5-flash

# 2. Taiwan Financial Data API (Highly Recommended)
# Register a free account at https://finmindtrade.com/ to get your token.
# If left empty, the client will run as a guest and will face strict hourly/daily rate limits.
FINMIND_API_TOKEN=your_finmind_api_token_here

# 3. SonarQube Quality Analysis (Required for run_sonar_analysis.sh if ForceAuthentication is enabled)
# Generate a User Token in the SonarQube Web UI (http://localhost:9000 -> My Account -> Security)
SONAR_TOKEN=sqp_your_sonarqube_token_here

# 4. Docker & Deployment Configuration (Optional)
# Used by docker-compose.yml to tag the built image for Docker Hub
DOCKER_USERNAME=yourusername
# MCP transport type: "stdio" (local agent execution) or "sse" (HTTP/SSE server for network agents)
MCP_TRANSPORT=sse

# 5. Database Configuration (Optional)
# Set to "postgres" to use PostgreSQL (highly recommended for K8s deployments), defaults to "sqlite"
DB_TYPE=sqlite
# Required only if DB_TYPE is "postgres"
DB_HOST=postgres-service.namespace.svc.cluster.local
DB_PORT=5432
DB_NAME=portfolio
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
